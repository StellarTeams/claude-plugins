{
    "$schema": "https://json.schemastore.org/claude-code-marketplace.json",
    "name": "stellarteams",
    "version": "1.1.0",
    "description": "Bundled plugins for Claude Code",
    "owner": {
        "name": "StellarTeams"
    },
    "allowCrossMarketplaceDependenciesOn": [
        "claude-plugins-official"
    ],
    "plugins": [
        {
            "name": "base-skills",
            "description": "Git workflow tools — commit messages, branch creation and OpenSpec integration.",
            "source": "./plugins/base-skills",
            "category": "development",
            "dependencies": [
                "context7@claude-plugins-official"
            ]
        },
        {
            "name": "notify",
            "description": "Native desktop notification when Claude Code needs your attention — macOS, Linux and Windows.",
            "source": "./plugins/notify",
            "category": "productivity"
        }
    ]
}
